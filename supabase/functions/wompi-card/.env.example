# Copy to a git-ignored environment file or configure in the TEST project's secret manager.
WOMPI_CARD_ENABLED=true
WOMPI_MODE=test
WOMPI_CARD_LIVE_ENABLED=false
WOMPI_APP_ID=
WOMPI_API_SECRET=
HYRO_SITE_URL=https://YOUR-TEST-SITE.example
LICENSE_ENCRYPTION_KEY=
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and SUPABASE_ANON_KEY are supplied by the Edge runtime.
# Optional publishable key override (never a service role key):
HYRO_SUPABASE_PUBLISHABLE_KEY=
