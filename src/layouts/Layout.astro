---
import '../styles/global.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import en from '../i18n/en.json';
interface Props {
  page?: 'home' | 'account';
}
const { page = 'home' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={
        page === 'account' ? en.accountMetaDescription : en.metaDescription
      }
    />
    <title>{page === 'account' ? en.accountPageTitle : en.pageTitle}</title>
    <script is:inline>
      try {
        const t = localStorage.getItem('hyro-theme');
        document.documentElement.dataset.theme =
          t === 'light' || t === 'dark'
            ? t
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
      } catch {
        document.documentElement.dataset.theme = matchMedia(
          '(prefers-color-scheme: dark)',
        ).matches
          ? 'dark'
          : 'light';
      }
    </script>
  </head>
  <body data-page={page}>
    <slot />
    <script>
      import '../scripts/init';
    </script>
  </body>
</html>
