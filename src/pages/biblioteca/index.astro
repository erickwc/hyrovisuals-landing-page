---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
---

<Layout page="library">
  <header class="site-header"><Navbar accountPage /></header>
  <main class="account-page library-page">
    <div class="account-layout library-layout page-shell">
      <div class="account-intro">
        <p class="account-eyebrow"><span class="account-eyebrow-dot"></span> TU CUENTA HYRO</p>
        <h1 class="account-title">
          <span class="gradient-text">Tu</span>
          <span class="gradient-text">biblioteca</span>
        </h1>
        <p class="account-intro-copy">Tus productos, licencias y descargas en un solo lugar.</p>
        <a class="account-back" href="/cuenta/">Volver a mi cuenta</a>
      </div>
      <section class="account-panel" aria-label="Productos comprados">
        <div class="account-panel-inner" data-library-root>
          <h2>Mis productos</h2>
          <p class="account-panel-copy" data-library-status role="status">Comprobando tus compras…</p>
          <div data-library-products></div>
        </div>
      </section>
    </div>
  </main>
</Layout>
