---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import en from '../../i18n/en.json';
---
<Layout page="account">
  <a class="skip-link" href="#main" data-i18n="skip">{en.skip}</a>
  <main id="main" class="auth-page">
    <img class="auth-logo" src="/images/hyro-mark.png" alt="HYRO" width="1000" height="1000" />
    <section class="auth-shell" aria-label={en.accountNav} data-i18n-aria="accountNav" data-auth-root>
      <div class="auth-view" data-auth-panel="login">
        <h1 aria-label={en.accountLoginTitle} data-i18n-aria="accountLoginTitle"><span class="auth-title-es" aria-hidden="true">INICIA SESI<span class="auth-accent-o">O</span>N</span><span class="auth-title-en" aria-hidden="true">LOG IN</span></h1>
        <form class="auth-form" data-auth-form="login" autocomplete="on">
          <div class="auth-field"><label for="login-email" data-i18n="accountEmail">{en.accountEmail}</label><div class="auth-input"><input id="login-email" name="email" type="email" placeholder="nombre@correo.com" autocomplete="email" required /></div></div>
          <div class="auth-field"><label for="login-password" data-i18n="accountPassword">{en.accountPassword}</label><div class="auth-password"><input id="login-password" name="password" type="password" placeholder="••••••••" autocomplete="current-password" required /><button type="button" data-password-toggle aria-label={en.accountShowPassword} aria-pressed="false"><span class="auth-eye-visible"><Icon name="eye" /></span><span class="auth-eye-hidden"><Icon name="eye-off" /></span></button></div></div>
          <button class="auth-submit" type="submit" data-auth-action="login"><span data-i18n="accountLoginAction">{en.accountLoginAction}</span></button>
        </form>
        <p class="auth-switch-copy"><span data-i18n="accountNoAccount">{en.accountNoAccount}</span> <button class="auth-text-link" type="button" data-auth-switch="register" data-i18n="accountCreateAccount">{en.accountCreateAccount}</button></p>
        <button class="auth-text-link auth-forgot" type="button" data-auth-switch="recover" data-i18n="accountForgotPassword">{en.accountForgotPassword}</button>
      </div>
      <div class="auth-view" data-auth-panel="register" hidden>
        <h1 class="auth-register-title" aria-label={en.accountRegisterTitle} data-i18n-aria="accountRegisterTitle"><span data-i18n="accountRegisterTitleLine1">{en.accountRegisterTitleLine1}</span><span data-i18n="accountRegisterTitleLine2">{en.accountRegisterTitleLine2}</span></h1>
        <form class="auth-form" data-auth-form="register" autocomplete="on">
          <div class="auth-field"><label for="register-name" data-i18n="accountName">{en.accountName}</label><div class="auth-input"><input id="register-name" name="name" type="text" placeholder="Tu nombre" autocomplete="name" maxlength="120" required /></div></div>
          <div class="auth-field"><label for="register-email" data-i18n="accountEmail">{en.accountEmail}</label><div class="auth-input"><input id="register-email" name="email" type="email" placeholder="nombre@correo.com" autocomplete="email" required /></div></div>
          <div class="auth-field"><label for="register-password" data-i18n="accountPassword">{en.accountPassword}</label><div class="auth-password"><input id="register-password" name="password" aria-describedby="register-password-hint" type="password" placeholder="••••••••" autocomplete="new-password" minlength="8" required /><button type="button" data-password-toggle aria-label={en.accountShowPassword} aria-pressed="false"><span class="auth-eye-visible"><Icon name="eye" /></span><span class="auth-eye-hidden"><Icon name="eye-off" /></span></button></div></div>
          <ul class="auth-password-rules" id="register-password-hint" aria-label={en.accountPasswordRequirements} data-i18n-aria="accountPasswordRequirements"><li data-password-rule="length" data-i18n="accountRuleLength">{en.accountRuleLength}</li><li data-password-rule="special" data-i18n="accountRuleSpecial">{en.accountRuleSpecial}</li><li data-password-rule="number" data-i18n="accountRuleNumber">{en.accountRuleNumber}</li><li data-password-rule="uppercase" data-i18n="accountRuleUppercase">{en.accountRuleUppercase}</li></ul>
          <button class="auth-submit" type="submit" data-auth-action="register"><span data-i18n="accountRegisterAction">{en.accountRegisterAction}</span></button>
        </form>
        <p class="auth-switch-copy"><span data-i18n="accountHaveAccount">{en.accountHaveAccount}</span> <button class="auth-text-link" type="button" data-auth-switch="login" data-i18n="accountLoginAction">{en.accountLoginAction}</button></p>
      </div>
      <div class="auth-view" data-auth-panel="recover" hidden>
        <h1 data-i18n="accountRecoverTitle">{en.accountRecoverTitle}</h1>
        <p class="auth-copy" data-i18n="accountRecoverDescription">{en.accountRecoverDescription}</p>
        <form class="auth-form" data-auth-form="recover">
          <div class="auth-field"><label for="recover-email" data-i18n="accountEmail">{en.accountEmail}</label><div class="auth-input"><input id="recover-email" name="email" type="email" placeholder="nombre@correo.com" autocomplete="email" required /></div></div>
          <button class="auth-submit" type="submit" data-auth-action="recover"><span data-i18n="accountRecoverAction">{en.accountRecoverAction}</span><Icon name="arrow" /></button>
        </form>
        <p class="auth-switch-copy"><button class="auth-text-link" type="button" data-auth-switch="login" data-i18n="accountBackToLogin">{en.accountBackToLogin}</button></p>
      </div>
      <div class="auth-view" data-auth-panel="reset" hidden>
        <h1 data-i18n="accountResetTitle">{en.accountResetTitle}</h1>
        <p class="auth-copy" data-i18n="accountResetDescription">{en.accountResetDescription}</p>
        <form class="auth-form" data-auth-form="reset">
          <div class="auth-field"><label for="reset-password" data-i18n="accountPassword">{en.accountPassword}</label><div class="auth-password"><input id="reset-password" name="password" type="password" placeholder="••••••••" autocomplete="new-password" minlength="8" required /><button type="button" data-password-toggle aria-label={en.accountShowPassword} aria-pressed="false"><span class="auth-eye-visible"><Icon name="eye" /></span><span class="auth-eye-hidden"><Icon name="eye-off" /></span></button></div></div>
          <div class="auth-field"><label for="reset-confirm" data-i18n="accountConfirmPassword">{en.accountConfirmPassword}</label><div class="auth-password"><input id="reset-confirm" name="confirmPassword" type="password" placeholder="••••••••" autocomplete="new-password" minlength="8" required /><button type="button" data-password-toggle aria-label={en.accountShowPassword} aria-pressed="false"><span class="auth-eye-visible"><Icon name="eye" /></span><span class="auth-eye-hidden"><Icon name="eye-off" /></span></button></div></div>
          <button class="auth-submit" type="submit" data-auth-action="reset"><span data-i18n="accountResetAction">{en.accountResetAction}</span><Icon name="arrow" /></button>
        </form>
      </div>
      <p class="auth-status" data-auth-status role="status" aria-live="polite" hidden></p>
      <div class="auth-view auth-signed-in" data-auth-signed-in hidden>
        <h1 data-i18n="accountSignedInTitle">{en.accountSignedInTitle}</h1>
        <p class="auth-copy" data-i18n="accountSignedInDescription">{en.accountSignedInDescription}</p>
        <p class="auth-user-email" data-auth-email></p>
        <a class="auth-submit" href="/biblioteca/" data-i18n="accountLibrary">{en.accountLibrary}</a>
        <a class="auth-text-link auth-admin-link" href="/admin/" data-auth-admin-link hidden data-i18n="accountAdminLink">{en.accountAdminLink}</a>
        <button class="auth-text-link auth-signout" type="button" data-auth-signout data-i18n="accountSignOut">{en.accountSignOut}</button>
      </div>
    </section>
  </main>
</Layout>