---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
---
<Layout page="checkout">
  <header class="site-header"><Navbar accountPage /></header>
  <main id="main" class="hyro-payment" data-whop-checkout>
    <header class="payment-heading">
      <a href="/#compra">← Volver al producto</a>
      <h1>Finalizar compra</h1>
      <p>HYRO Visuals · Licencia personal para un equipo a la vez.</p>
    </header>
    <section aria-label="Datos y resumen del pedido">
      <p class="payment-status" data-whop-status role="status" aria-live="polite">Preparando tu pago seguro…</p>
      <div id="hyro-whop-checkout"></div>
      <button class="payment-retry" type="button" data-whop-retry hidden>Volver a intentar</button>
    </section>
    <footer class="payment-footer">
      <p>Tu clave de activación y la descarga de Windows estarán en tu biblioteca cuando se confirme el pago.</p>
      <a href="/biblioteca/">Mi biblioteca ↗</a>
    </footer>
  </main>
</Layout>
<style>
  .hyro-payment { width: min(1120px, calc(100% - 48px)); margin: 0 auto; padding: calc(var(--nav-height) + 40px) 0 48px; min-height: 100svh; }
  .payment-heading { margin-bottom: 32px; }
  .payment-heading a, .payment-footer { font-size: 13px; color: var(--secondary); }
  .payment-heading a:hover, .payment-footer a:hover { color: var(--text); }
  .payment-heading h1 { font-family: var(--font-body); font-size: clamp(25px, 3vw, 34px); line-height: 1.2; font-weight: 600; letter-spacing: -.035em; margin: 20px 0 10px; }
  .payment-heading p { color: var(--secondary); font-size: 14px; line-height: 1.6; }
  #hyro-whop-checkout { width: 100%; min-width: 0; }
  .payment-status { font-size: 14px; color: var(--secondary); }
  .payment-status:empty { display: none; }
  .payment-retry { padding: 14px 24px; margin-top: 20px; background: var(--button-bg); color: var(--button-text); border-radius: 5px; cursor: pointer; }
  .payment-footer { display: flex; justify-content: space-between; gap: 32px; border-top: 1px solid var(--border); margin-top: 32px; padding-top: 24px; line-height: 1.7; }
  .payment-footer p { max-width: 590px; }
  .payment-footer a { white-space: nowrap; }
  @media(max-width: 640px) { .hyro-payment { width: calc(100% - 32px); padding-top: calc(var(--nav-height) + 24px); } .payment-footer { flex-direction: column; gap: 12px; } }
</style>
