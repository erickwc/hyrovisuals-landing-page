---
import Layout from '../../layouts/Layout.astro';
---
<Layout page="checkout">
  <main id="main" class="hyro-payment" data-whop-checkout>
    <div class="payment-layout">
      <div class="payment-information">
        <header class="payment-heading">
          <button class="payment-back" type="button" data-checkout-back aria-label="Volver atrás">
            <svg class="payment-back-arrow" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
            </svg>
            <span class="payment-back-brand">
              <img class="payment-back-mark" src="/images/hyro-mark.png" alt="" width="28" height="28" />
              <span class="payment-back-label" aria-hidden="true">
                <span class="payment-back-default">HYRO LLC</span>
                <span class="payment-back-hover">Volver atrás</span>
              </span>
            </span>
          </button>
        </header>
        <section class="payment-summary" aria-label="Resumen del pedido">
          <p class="payment-price"><span data-price-amount>—</span> <span data-price-currency></span></p>
          <div class="payment-product-description" data-product-description hidden>
            <h2>¿Qué incluye HYRO Visuals?</h2>
            <p data-product-description-copy></p>
            <ul data-product-features></ul>
          </div>
          <p class="payment-delivery">Tu clave de activación y la descarga de Windows estarán en tu biblioteca cuando se confirme el pago.</p>
        </section>
      </div>
      <section class="payment-form" aria-label="Pago seguro">
        <p class="payment-status" data-whop-status role="status" aria-live="polite">Preparando tu pago seguro…</p>
        <div id="hyro-whop-checkout"></div>
        <button class="payment-retry" type="button" data-whop-retry hidden>Volver a intentar</button>
      </section>
    </div>
  </main>
</Layout>
<style>
  .hyro-payment { width: min(920px, calc(100% - 40px)); margin: 0 auto; padding: 72px 0 72px; min-height: 100svh; }
  .payment-heading { margin-bottom: 22px; }
  .payment-back { display: inline-flex; min-height: 32px; align-items: center; gap: 20px; padding: 2px 0; border: 0; border-radius: 0; background: transparent; color: var(--text); font: 500 13px/1.4 var(--font-body); cursor: pointer; }
  .payment-back-arrow { display: inline-block; width: 18px; height: 18px; flex: 0 0 18px; color: var(--secondary); transition: transform .28s ease, color .2s ease; }
  .payment-back:hover .payment-back-arrow, .payment-back:focus-visible .payment-back-arrow { transform: translateX(-3px); color: var(--text); }
  .payment-back-brand { display: inline-flex; align-items: center; gap: 6px; }
  .payment-back-mark { display: block; width: 28px; height: 28px; box-sizing: border-box; border: 1px solid color-mix(in srgb, var(--border) 56%, transparent); border-radius: 8px; object-fit: cover; }
  .payment-back-label { position: relative; display: inline-grid; align-items: center; min-width: 90px; height: 1.2em; }
  .payment-back-default, .payment-back-hover { grid-area: 1 / 1; white-space: nowrap; transition: opacity .24s ease, transform .24s ease; }
  .payment-back-default { opacity: 1; transform: translateY(0); }
  .payment-back-hover { opacity: 0; transform: translateY(4px); }
  .payment-back:hover .payment-back-default, .payment-back:focus-visible .payment-back-default { opacity: 0; transform: translateY(-4px); }
  .payment-back:hover .payment-back-hover, .payment-back:focus-visible .payment-back-hover { opacity: 1; transform: translateY(0); }
  .payment-layout { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 80px; align-items: stretch; }
  .payment-information { box-sizing: border-box; min-height: calc(100svh - 144px); padding: 22px; border: 1px solid color-mix(in srgb, var(--border) 55%, transparent); border-radius: 14px; background: var(--surface); }
  .payment-summary { padding: 0; border: 0; background: transparent; }
  .payment-price { font-size: clamp(35px,4vw,48px); line-height: 1.1; letter-spacing: -.04em; font-weight: 600; margin: 0; }
  .payment-price [data-price-currency] { font-size: 17px; letter-spacing: 0; font-weight: 500; }
  .payment-product-description { margin-top: 22px; color: var(--secondary); }
  .payment-product-description[hidden] { display: none; }
  .payment-product-description h2 { color: var(--text); font-size: 15px; line-height: 1.45; font-weight: 600; margin: 0 0 10px; }
  .payment-product-description [data-product-description-copy] { color: var(--secondary); font-size: 13px; line-height: 1.6; margin: 0 0 12px; }
  .payment-product-description [data-product-description-copy]:empty { display: none; }
  .payment-product-description ul { display: grid; gap: 7px; list-style: none; padding: 0; margin: 0; }
  :global(.payment-product-description li) { display: grid; grid-template-columns: 16px minmax(0,1fr); align-items: start; gap: 8px; color: var(--secondary); font-size: 13px; line-height: 1.55; }
  :global(.payment-feature-check) { display: block; width: 16px; height: 16px; margin-top: 1px; color: var(--text); }
  .payment-delivery { max-width: 370px; font-size: 13px; color: var(--secondary); line-height: 1.65; margin-top: 15px; }
  .payment-form, #hyro-whop-checkout { min-width: 0; width: 100%; }
  .payment-form { padding-top: 0; }
  .payment-status { font-size: 14px; color: var(--secondary); }
  .payment-status:empty { display: none; }
  .payment-retry { padding: 14px 24px; margin-top: 20px; background: var(--button-bg); color: var(--button-text); border-radius: 5px; cursor: pointer; }
  @media(max-width: 760px) { .hyro-payment { width: calc(100% - 32px); padding-top: 44px; } .payment-heading { margin-bottom: 20px; } .payment-layout { grid-template-columns: 1fr; gap: 32px; } .payment-information { min-height: 0; padding: 20px; } }
  @media(prefers-reduced-motion: reduce) { .payment-back, .payment-back-arrow, .payment-back-default, .payment-back-hover { transition: none; } }
</style>
