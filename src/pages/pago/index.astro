---
import Layout from '../../layouts/Layout.astro';
---
<Layout page="checkout">
  <main id="main" class="hyro-payment" data-whop-checkout>
    <div class="payment-layout">
      <div class="payment-information">
        <header class="payment-heading">
          <button class="payment-back" type="button" data-checkout-back aria-label="Volver atrás">
            <span class="payment-back-default">HYRO</span>
            <span class="payment-back-hover" aria-hidden="true">← Volver atrás</span>
          </button>
        </header>
        <section class="payment-summary" aria-label="Resumen del pedido">
          <p class="payment-price"><span data-price-amount>—</span> <span data-price-currency></span></p>
          <div class="payment-product-description" data-product-description hidden>
            <h2 data-product-description-heading></h2>
            <ul data-product-features></ul>
          </div>
          <p class="payment-delivery">Tu clave de activación y la descarga de Windows estarán en tu biblioteca cuando se confirme el pago.</p>
          <a class="payment-library" href="/biblioteca/">Mi biblioteca ↗</a>
        </section>
      </div>
      <section class="payment-form" aria-label="Pago seguro">
        <p class="payment-status" data-whop-status role="status" aria-live="polite">Preparando tu pago seguro…</p>
        <div id="hyro-whop-checkout"></div>
        <button class="payment-retry" type="button" data-whop-retry hidden>Volver a intentar</button>
      </section>
    </div>
  </main>
</Layout>
<style>
  .hyro-payment { width: min(920px, calc(100% - 40px)); margin: 0 auto; padding: 44px 0 72px; min-height: 100svh; }
  .payment-heading { margin-bottom: 22px; }
  .payment-back { display: inline-flex; min-height: 28px; align-items: center; padding: 0; border: 0; background: transparent; color: var(--secondary); font: 500 14px/1.4 var(--font-body); cursor: pointer; }
  .payment-back:hover, .payment-back:focus-visible { color: var(--text); }
  .payment-back-hover { display: none; }
  .payment-back:hover .payment-back-default, .payment-back:focus-visible .payment-back-default { display: none; }
  .payment-back:hover .payment-back-hover, .payment-back:focus-visible .payment-back-hover { display: inline; }
  .payment-library { font-size: 13px; color: var(--secondary); }
  .payment-library:hover { color: var(--text); }
  .payment-layout { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 80px; align-items: start; }
  .payment-summary { padding-top: 0; }
  .payment-price { font-size: clamp(35px,4vw,48px); line-height: 1.1; letter-spacing: -.04em; font-weight: 600; margin: 0; }
  .payment-price [data-price-currency] { font-size: 17px; letter-spacing: 0; font-weight: 500; }
  .payment-product-description { margin-top: 22px; color: var(--secondary); }
  .payment-product-description[hidden] { display: none; }
  .payment-product-description h2 { color: var(--text); font-size: 15px; line-height: 1.45; font-weight: 600; margin: 0 0 10px; }
  .payment-product-description ul { list-style: disc; padding-left: 19px; margin: 0; }
  .payment-product-description li { font-size: 13px; line-height: 1.65; padding-left: 3px; }
  .payment-delivery { max-width: 370px; font-size: 13px; color: var(--secondary); line-height: 1.65; margin-top: 15px; }
  .payment-library { display: inline-block; margin-top: 18px; }
  .payment-form, #hyro-whop-checkout { min-width: 0; width: 100%; }
  .payment-form { padding-top: 40px; }
  .payment-status { font-size: 14px; color: var(--secondary); }
  .payment-status:empty { display: none; }
  .payment-retry { padding: 14px 24px; margin-top: 20px; background: var(--button-bg); color: var(--button-text); border-radius: 5px; cursor: pointer; }
  @media(max-width: 760px) { .hyro-payment { width: calc(100% - 32px); padding-top: 28px; } .payment-heading { margin-bottom: 20px; } .payment-layout { grid-template-columns: 1fr; gap: 32px; } .payment-form { padding-top: 0; } }
</style>
