---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
---

<Layout page="processing">
  <header class="site-header"><Navbar accountPage /></header>
  <main class="account-page purchase-processing-page">
    <section class="purchase-processing page-shell" data-purchase-processing aria-labelledby="purchase-processing-title">
      <p class="account-eyebrow"><span class="account-eyebrow-dot" aria-hidden="true"></span> TU COMPRA HYRO</p>
      <span class="purchase-processing-orbit" aria-hidden="true"></span>
      <h1 id="purchase-processing-title">Preparando<br /><span class="gradient-text">tu acceso.</span></h1>
      <p class="purchase-processing-lead">Estamos preparando HYRO Visuals para tu cuenta.</p>
      <p class="purchase-processing-status" data-processing-status role="status" aria-live="polite">Preparando tu acceso…</p>
      <p class="purchase-processing-note">En cuanto esté listo, te llevaremos automáticamente a Mi biblioteca.</p>
      <a class="account-back" href="/cuenta/" data-processing-back hidden>Volver a mi cuenta</a>
    </section>
  </main>
</Layout>
