---
import Layout from '../../layouts/Layout.astro';
---

<Layout page="checkout">
  <main class="test-page">
    <div class="test-content">
      <a href="/" class="back">← HYRO</a>
      <p class="eyebrow">PRUEBA AISLADA</p>
      <h1>Checkout embebido de Payhip</h1>
      <p>Esta página registra los argumentos completos que Payhip entregue al confirmar la compra. No modifica tu biblioteca ni el flujo de compra actual.</p>
      <button id="open-checkout" type="button" disabled>Abrir pago de prueba</button>
      <p id="checkout-status" role="status" aria-live="polite">Cargando Payhip…</p>
      <div class="result-head"><h2>Resultado del callback</h2><button id="copy-result" type="button" hidden>Copiar resultado</button></div>
      <pre id="callback-result">Aún no se ha recibido el callback.</pre>
    </div>
  </main>
  <script is:inline src="https://payhip.com/payhip.js"></script>
  <script is:inline>
    (() => {
      const openButton = document.getElementById('open-checkout');
      const copyButton = document.getElementById('copy-result');
      const status = document.getElementById('checkout-status');
      const result = document.getElementById('callback-result');
      let output = '';
      const serialize = (value) => {
        const seen = new WeakSet();
        try {
          return JSON.stringify(value, (_key, item) => {
            if (typeof item === 'bigint') return item.toString();
            if (typeof item === 'object' && item !== null) {
              if (seen.has(item)) return '[Circular]';
              seen.add(item);
            }
            return item;
          }, 2) ?? String(value);
        } catch (error) { return `No se pudo serializar: ${String(error)}`; }
      };
      const ready = () => {
        if (window.Payhip?.Checkout?.open) {
          openButton.disabled = false;
          status.textContent = 'Payhip listo para abrir el pago.';
          return true;
        }
        return false;
      };
      if (!ready()) {
        let attempts = 0;
        const timer = setInterval(() => {
          if (ready()) clearInterval(timer);
          else if (++attempts >= 50) {
            clearInterval(timer);
            status.textContent = 'No se pudo cargar Payhip. Actualiza la página para reintentar.';
          }
        }, 200);
      }
      openButton.addEventListener('click', () => {
        if (!window.Payhip?.Checkout?.open) return;
        const sessionId = crypto.randomUUID();
        result.textContent = `Sesión de prueba: ${sessionId}\nEsperando el callback de Payhip…`;
        status.textContent = 'Pago de prueba abierto.';
        try {
          window.Payhip.Checkout.open({
            product: 'YKAQI',
            method: 'overlay',
            metadata: { hyro_test_session: sessionId },
            successCallback: function (...args) {
              output = serialize(args);
              console.log('Payhip successCallback — argumentos completos:', output);
              result.textContent = output;
              copyButton.hidden = false;
              status.textContent = 'Callback recibido. Puedes copiar el resultado.';
            },
          });
        } catch (error) {
          status.textContent = `No se pudo abrir el pago: ${String(error)}`;
        }
      });
      copyButton.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(output); status.textContent = 'Resultado copiado.'; }
        catch { status.textContent = 'No se pudo copiar automáticamente. Selecciona el texto de abajo.'; }
      });
    })();
  </script>
</Layout>

<style>
  .test-page{min-height:100vh;background:#080808;color:#f5f5f5;padding:clamp(2rem,6vw,5rem) 1.25rem;font-family:Inter,sans-serif}
  .test-content{max-width:760px;margin:auto}.back{color:#bbb;text-decoration:none}.eyebrow{margin:3rem 0 .75rem;color:#aaa;font-size:.75rem;letter-spacing:.16em}
  h1{font-size:clamp(2rem,5vw,3.5rem);line-height:1.1;margin:0 0 1rem}p{color:#bbb;line-height:1.6}button{min-height:44px;border:0;border-radius:10px;padding:.75rem 1.1rem;cursor:pointer}
  #open-checkout{background:#fff;color:#111;font-weight:600;margin:1.5rem 0 .5rem}button:disabled{opacity:.5;cursor:wait}#checkout-status{min-height:1.5em}
  .result-head{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:2.5rem}h2{font-size:1rem;margin:0}#copy-result{background:#252525;color:#fff}
  pre{white-space:pre-wrap;overflow-wrap:anywhere;border:1px solid #333;border-radius:12px;padding:1rem;min-height:9rem;color:#ddd;background:#111;user-select:text}
</style>
