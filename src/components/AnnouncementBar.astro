---
import en from '../i18n/en.json';
---

<a
  class="announcement-bar"
  href="#compra"
  aria-label={en.announcement}
  data-i18n-aria="announcement"
>
  <span class="announcement-track" aria-hidden="true">
    {Array.from({ length: 2 }, () => (
      <span class="announcement-set">
        {Array.from({ length: 3 }, () => (
          <span data-i18n="announcement">{en.announcement}</span>
        ))}
      </span>
    ))}
  </span>
</a>
