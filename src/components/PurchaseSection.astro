---
import Icon from './Icon.astro';
import en from '../i18n/en.json';

const personalBenefits = ['purchasePersonalKey', 'purchasePersonalAccess', 'purchasePersonalDownload'] as const;
const teamsBenefits = ['purchaseTeamsKeys', 'purchaseTeamsAccess', 'purchaseTeamsDownload'] as const;
---

<section
  id="compra"
  class="purchase-section"
  aria-labelledby="purchase-heading"
>
  <div class="purchase-layout page-shell">
    <div class="purchase-copy">
      <h2
        id="purchase-heading"
        class="purchase-heading"
        data-anim="purchase-copy"
      >
        <span>HYRO</span>
        <span class="gradient-text">VISUALS</span>
      </h2>
      <p
        class="purchase-description"
        data-i18n="purchaseDescription"
        data-anim="purchase-copy"
      >
        {en.purchaseDescription}
      </p>
      <ul class="purchase-benefits" data-license-benefits="personal" aria-live="polite">
        {personalBenefits.map((key) => (
          <li data-anim="purchase-benefit">
            <span data-i18n={key}>{en[key]}</span>
          </li>
        ))}
      </ul>
      <ul class="purchase-benefits" data-license-benefits="teams" hidden>
        {teamsBenefits.map((key) => (
          <li><span data-i18n={key}>{en[key]}</span></li>
        ))}
      </ul>
    </div>

    <div class="purchase-choice" data-anim="purchase-card" data-license-choice>
      <h3 data-i18n="licenseChoiceTitle">{en.licenseChoiceTitle}</h3>
      <div class="purchase-license-options" role="radiogroup" aria-label={en.licenseChoiceTitle} data-i18n-aria="licenseChoiceTitle">
        <button class="purchase-license-option is-selected" type="button" role="radio" aria-checked="true" data-license-option="personal">
          <span class="purchase-license-top">
            <span class="purchase-license-indicator" aria-hidden="true"></span>
            <strong data-i18n="licensePersonal">{en.licensePersonal}</strong>
            <span class="purchase-license-price" data-license-price aria-live="polite">—</span>
          </span>
          <span class="purchase-license-detail" data-i18n="licensePersonalDescription">{en.licensePersonalDescription}</span>
        </button>
        <button class="purchase-license-option" type="button" role="radio" aria-checked="false" data-license-option="teams">
          <span class="purchase-license-top">
            <span class="purchase-license-indicator" aria-hidden="true"></span>
            <strong data-i18n="licenseTeams">{en.licenseTeams}</strong>
            <span class="purchase-license-soon" data-i18n="licenseTeamsSoon">{en.licenseTeamsSoon}</span>
          </span>
          <span class="purchase-license-detail" data-i18n="licenseTeamsDescription">{en.licenseTeamsDescription}</span>
        </button>
      </div>
      <div class="purchase-license-message" aria-live="polite">
        <p data-license-message="personal" data-i18n="purchaseDeviceNote">{en.purchaseDeviceNote}</p>
        <p data-license-message="teams" data-i18n="licenseTeamsPending" hidden>{en.licenseTeamsPending}</p>
      </div>
      <a class="purchase-button" href="/pago/" data-license-continue>
        <span data-i18n="purchaseNow">{en.purchaseNow}</span>
        <Icon name="arrow" />
      </a>
      <div class="purchase-footer">
        <ul class="purchase-payment-methods" data-i18n-aria="purchasePaymentMethods" aria-label={en.purchasePaymentMethods}>
          <li class="payment-method payment-visa"><img src="/images/payment/visa.png" alt="Visa" width="600" height="203" /></li>
          <li class="payment-method payment-mastercard" aria-label="Mastercard"><span aria-hidden="true"></span><span aria-hidden="true"></span></li>
          <li class="payment-method payment-paypal"><img src="/images/payment/paypal.png" alt="PayPal" width="600" height="148" /></li>
          <li class="payment-method payment-google"><img src="/images/payment/google-pay.png" alt="Google Pay" width="600" height="225" /></li>
          <li class="payment-method payment-apple"><img src="/images/payment/apple-pay.png" alt="Apple Pay" width="600" height="250" /></li>
        </ul>
        <div class="purchase-secure"><Icon name="lock" /><span data-i18n="purchaseSecurePayment">{en.purchaseSecurePayment}</span></div>
      </div>
    </div>
  </div>
</section>
