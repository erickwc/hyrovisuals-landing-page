---
import Icon from './Icon.astro';
import en from '../i18n/en.json';
---

<button
  class="language-control"
  type="button"
  id="language"
  aria-label={en.languageToEs}
  data-language-toggle
  data-i18n-aria="languageToEs"
>
  <Icon name="language" />
  <span data-language-current>EN</span>
</button>
