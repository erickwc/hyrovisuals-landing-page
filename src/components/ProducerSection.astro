---
import Icon from './Icon.astro';
import en from '../i18n/en.json';

const producers = [
  { name: 'Antian Rose', image: '/images/producers/antian-rose.jpg', caption: 'producerAntianCaption' },
  { name: 'Rick Tyver', image: '/images/producers/rick-tyver.jpg', caption: 'producerRickCaption' },
  { name: 'Beats By Carlos', image: '/images/producers/beats-by-carlos.jpg', caption: 'producerCarlosCaption' },
  { name: 'Naito', image: '/images/producers/naito.jpg', caption: 'producerNaitoCaption' },
  { name: 'Diegod', image: '/images/producers/diegod.jpg', caption: 'producerDiegodCaption' },
] as const;
---

<section id="enfoque" class="producer-section" aria-labelledby="producer-heading">
  <div class="page-shell producer-inner">
    <div class="producer-heading-row">
      <div class="producer-heading-copy">
        <h2 id="producer-heading" data-i18n="producersTitle">{en.producersTitle}</h2>
        <p data-i18n="producersIntro">{en.producersIntro}</p>
      </div>
      <div class="producer-controls">
        <button class="producer-pause" type="button" data-producer-pause aria-label={en.producerPause} data-i18n-aria="producerPause" aria-pressed="false"><span aria-hidden="true">Ⅱ</span></button>
        <button type="button" data-producer-prev aria-label={en.producerPrevious} data-i18n-aria="producerPrevious"><Icon name="arrow" /></button>
        <button type="button" data-producer-next aria-label={en.producerNext} data-i18n-aria="producerNext"><Icon name="arrow" /></button>
      </div>
    </div>
    <div class="producer-carousel" role="region" aria-label={en.producersTitle} data-i18n-aria="producersTitle" data-producer-carousel tabindex="0">
      {producers.map((producer, index) => (
        <figure class="producer-card">
          <div class="producer-card-top">
            <img src={producer.image} alt={producer.name} width="150" height="150" loading="lazy" />
            <span class="producer-card-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          </div>
          <figcaption>
            <strong>{producer.name}</strong>
            <p data-i18n={producer.caption}>{en[producer.caption]}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
