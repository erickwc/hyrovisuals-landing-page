---
import LanguageSelector from './LanguageSelector.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import en from '../i18n/en.json';
interface Props {
  accountPage?: boolean;
}
const { accountPage = false } = Astro.props;
const links = [
  ['inicio', 'navHome'],
  ['personalizacion', 'navFunctions'],
  ['enfoque', 'navAudience'],
  ['faq', 'navQuestions'],
] as const;
---

<nav
  class="navbar page-shell"
  aria-label={en.navigation}
  data-i18n-aria="navigation"
>
  <a
    href={accountPage ? '/#inicio' : '#inicio'}
    class="brand"
    aria-label={en.brandHome}
    data-i18n-aria="brandHome"
  >
    <span class="brand-crop">
      <img
        src="/images/hyro-logo.png"
        alt="Hyro"
        width="5339"
        height="724"
        fetchpriority="high"
      />
    </span>
  </a>
  <div class="nav-links" id="navigation-links">
    {links.map(([id, key]) => (
      <a href={`${accountPage ? '/' : ''}#${id}`} data-i18n={key}>
        {en[key]}
      </a>
    ))}
  </div>
  <div class="nav-controls">
    <LanguageSelector />
    <ThemeToggle />
    <div class="account-menu" data-account-menu>
      <a
        class="account-link"
        href="/cuenta/"
        aria-label={en.accountNav}
        data-i18n-aria="accountNav"
        data-account-login
        aria-current={accountPage ? 'page' : undefined}
      >
        <Icon name="user" />
      </a>
      <button
        class="account-trigger"
        type="button"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="account-dropdown"
        data-account-trigger
        hidden
      >
        <span class="account-name" data-account-name></span>
        <Icon name="chevron" />
      </button>
      <div
        class="account-dropdown"
        id="account-dropdown"
        data-account-dropdown
        hidden
      >
        <a href="/biblioteca/" role="menuitem" data-i18n="accountMenuProducts">
          <Icon name="products" />
          <span>{en.accountMenuProducts}</span>
        </a>
        <a href="/cuenta/" role="menuitem" data-i18n="accountMenuSettings">
          <Icon name="settings" />
          <span>{en.accountMenuSettings}</span>
        </a>
        <button type="button" role="menuitem" data-account-signout>
          <Icon name="logout" />
          <span data-i18n="accountMenuSignOut">{en.accountMenuSignOut}</span>
        </button>
      </div>
    </div>
    <button
      type="button"
      class="menu-toggle"
      aria-controls="navigation-links"
      aria-expanded="false"
      aria-label={en.menuOpen}
      data-i18n-aria="menuOpen"
    >
      <Icon name="menu" />
    </button>
  </div>
</nav>
