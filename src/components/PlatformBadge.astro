---
interface Props {
  platform: 'mac' | 'windows';
  label: string;
}
const { platform, label } = Astro.props;
---

<span
  class="platform-badge"
  role="img"
  aria-label={label}
  data-i18n-aria={platform}
>
  {platform === 'windows' ? (
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="m2 4 9-1.2v8.4H2zm10.2-1.4L22 1.3v9.9h-9.8zM2 12.5h9v8.4L2 19.7zm10.2 0H22v10l-9.8-1.4z" />
    </svg>
  ) : (
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.3 12.7c0-2 1.6-3 1.7-3.1-1-1.5-2.5-1.7-3.1-1.7-1.3-.1-2.5.8-3.2.8-.6 0-1.6-.8-2.7-.8-1.4 0-2.7.8-3.4 2-1.5 2.5-.4 6.2 1 8.2.7 1 1.5 2 2.5 2 1 0 1.4-.7 2.7-.7s1.7.7 2.8.7 1.8-1 2.4-2c.8-1.1 1.1-2.2 1.1-2.3-.1 0-1.8-.7-1.8-3.1ZM15.2 6.6c.5-.7.9-1.6.8-2.6-.8 0-1.8.5-2.4 1.2-.5.6-1 1.6-.9 2.5.9.1 1.8-.5 2.5-1.1Z" />
    </svg>
  )}
</span>
