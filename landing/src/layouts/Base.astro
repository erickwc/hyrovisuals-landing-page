---
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import type { Lang } from '../i18n';
import { useDict } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = useDict(lang);
const site = 'https://byhyro.com';
const url = lang === 'en' ? `${site}/en/` : `${site}/`;
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{d.meta.title}</title>
    <meta name="description" content={d.meta.description} />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="es" href={`${site}/`} />
    <link rel="alternate" hreflang="en" href={`${site}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hyro Visuals" />
    <meta property="og:title" content={d.meta.title} />
    <meta property="og:description" content={d.meta.description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={d.meta.locale} />
    <meta property="og:image" content={`${site}/icons/icon-512.png`} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" as="font" href="/fonts/monument-extended-ultrabold.woff2" type="font/woff2" crossorigin />
    <script is:inline src="/boot.js"></script>
  </head>
  <body>
    <slot />
  </body>
</html>
